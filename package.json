{
  "name": "hundeforsikring",
  "version": "1.0.0",
  "description": "Sammenlign hundeforsikring priser i hele Danmark",
  "main": "index.html",
  "scripts": {
    "dev": "vercel dev",
    "build": "echo 'Static site - no build needed'",
    "start": "vercel dev",
    "generate-kommuner": "node scripts/generate-kommune-pages.js",
    "scrape-data": "node scripts/scrape-insurance-data.js",
    "validate-data": "node scripts/validate-data.js",
    "monitor-prices": "node scripts/price-monitor.js",
    "update-version": "node scripts/update-version.js",
    "update-all": "npm run scrape-data && npm run validate-data && npm run monitor-prices",
    "force-refresh": "npm run update-version && echo 'Cache busting completed! Refresh your browser.'"
  },
  "keywords": [
    "hundeforsikring",
    "hundeansvarsforsikring",
    "danmark",
    "sammenlign",
    "forsikring"
  ],
  "author": "Martin Galmarino",
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^23.2.0",
    "vercel": "^32.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
