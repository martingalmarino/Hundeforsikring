{
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/forsikring/(.*)",
      "destination": "/forsikring/$1/index.html"
    },
    {
      "source": "/guide/(.*)",
      "destination": "/guide/$1/index.html"
    },
    {
      "source": "/faq",
      "destination": "/faq/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
                {
                  "source": "/(.*\\.css)",
                  "headers": [
                    {
                      "key": "Cache-Control",
                      "value": "no-cache, no-store, must-revalidate"
                    },
                    {
                      "key": "Pragma",
                      "value": "no-cache"
                    },
                    {
                      "key": "Expires",
                      "value": "0"
                    }
                  ]
                },
                {
                  "source": "/(.*\\.js)",
                  "headers": [
                    {
                      "key": "Cache-Control",
                      "value": "no-cache, no-store, must-revalidate"
                    },
                    {
                      "key": "Pragma",
                      "value": "no-cache"
                    },
                    {
                      "key": "Expires",
                      "value": "0"
                    }
                  ]
                }
  ]
}
